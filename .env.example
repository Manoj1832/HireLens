# ====================================================================
# HIRELENS — ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================

# Application Core
APP_ENV=development
APP_NAME=HireLens
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Institutional Rules
COLLEGE_ALLOWED_DOMAINS=psgtech.ac.in,student.psgtech.ac.in

# Supabase / PostgreSQL Database
# Connect directly to Postgres URL or Supabase transaction pooler
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hirelens
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Redis (Upstash or Local)
REDIS_URL=https://aware-shad-283254.upstash.io
TOKEN=your-token-here

# Amazon S3 (Private Resume Storage)
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=hirelens-bucket-resume-storage
S3_ENDPOINT_URL=

# Groq LLM API (MCQ Generation & Structured Processing)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Email Notifications (Backend-controlled transactional SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=placement@psgtech.ac.in
SMTP_PASSWORD=your-smtp-app-password
EMAIL_FROM=placement@psgtech.ac.in
