# ==============================================================================
# HireLens Master .gitignore
# Multi-stack monorepo: Next.js 16 + FastAPI + Python Workers + PyTorch/Transformers
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Next.js & Frontend Artifacts
# ------------------------------------------------------------------------------
.next/
**/.next/
**/out/
**/build/
**/dist/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 2. Node Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.turbo/

# ------------------------------------------------------------------------------
# 3. Python, FastAPI & PyTorch/ML Artifacts
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Note: bare lib/ and lib64/ removed to prevent accidentally ignoring frontend/lib/
!frontend/lib/
!frontend/lib/**
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Pytest, Coverage, Typing & Linting
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/

# ------------------------------------------------------------------------------
# 4. Virtual Environments
# ------------------------------------------------------------------------------
.venv/
**/.venv/
venv/
**/venv/
ENV/
env/
**/env/

# ------------------------------------------------------------------------------
# 5. Local Uploads, Databases & Runtime Caches
# ------------------------------------------------------------------------------
backend/uploads/resumes/*.pdf
**/uploads/resumes/*.pdf
**/uploads/*
!**/uploads/.gitkeep
!**/uploads/resumes/.gitkeep

# Temporary HireLens JSON Persistence & Cache Files
hirelens_*.json
/tmp/hirelens_*.json
*.sqlite3
*.db
*.log
logs/
*.tmp

# ------------------------------------------------------------------------------
# 6. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
**/.env.*.local
!**/.env.example
.env.example

# ------------------------------------------------------------------------------
# 7. Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
